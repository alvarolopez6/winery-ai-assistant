# Copy this file to .env and replace every placeholder.
# Never commit the real .env.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
TZ=Europe/Madrid

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=winery
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=winery

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Public webhook gateway
# ---------------------------------------------------------------------------
# Set this to the Cloudflare Tunnel URL when you expose the gateway.
PUBLIC_BASE_URL=http://localhost:8080/
FORWARD_TIMEOUT=30

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
# Optional for a local-only demo. Set it if you expose Qdrant outside Docker.
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Meta / Instagram
# ---------------------------------------------------------------------------
# Used by the production webhook verification step.
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# DeepSeek is the chat model used by the n8n workflow.
# Gemini is used for embeddings (Qdrant and the local Python demo).
# Configure both inside n8n credentials; these values are a checklist.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional overrides for the local demo scripts.
# DEEPSEEK_CHAT_MODEL=deepseek-flash
# EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDING_DIM=0
